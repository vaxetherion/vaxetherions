# .npmrc — Supply chain hardening untuk vaxetherion-profile
# Format: INI-style, bukan JSON — komentar pakai # diizinkan.

# Paksa instalasi dari lockfile agar hasilnya reproducible.
# Perubahan dependency harus melewati `npm install` eksplisit, bukan `npm ci`.
package-lock=true

# Audit otomatis saat npm install / npm ci — blokir paket dengan vulnerability kritis.
audit=true
audit-level=critical

# Aktifkan npm provenance — setiap paket yang dipublish akan menyertakan
# sertifikat kriptografi (SLSA Provenance) yang membuktikan asal-usul paket
# berasal dari CI/CD yang sah, bukan dari mesin lokal yang dikompromi.
# Catatan: hanya berfungsi saat publish dari GitHub Actions (butuh OIDC token).
provenance=true

# Nonaktifkan optional dependency yang tidak diperlukan (mengurangi attack surface).
optional=false

# Nonaktifkan fund prompt agar instalasi lebih cepat dan bersih.
fund=false
